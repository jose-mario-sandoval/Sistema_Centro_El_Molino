{
  "name": "centro-el-molino",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:integracion": "vitest run --project integracion",
    "test:e2e": "playwright test",
    "db:tipos": "supabase gen types typescript --linked --schema public > lib/supabase/database.types.ts",
    "db:aplicar": "node --env-file=.env.local scripts/aplicar-migraciones.mjs",
    "crear-director": "tsx --env-file=.env.local scripts/crear-director.ts",
    "datos-demo": "tsx --env-file=.env.local scripts/datos-demo.ts",
    "limpiar-datos-demo": "tsx --env-file=.env.local scripts/limpiar-datos-demo.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "web-push": "^3.6.7",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "pg": "^8.23.0",
    "supabase": "^2.117.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
