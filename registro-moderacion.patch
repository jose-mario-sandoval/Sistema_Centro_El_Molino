+      { ...cursor, eliminadoEn: 'ayer,eliminado_en.gt.2000' },
+    ]) {
+      expect((await cargarRegistroModeracion({ antesDe })).ok).toBe(false)
+    }
+    expect(listarRegistroModeracion).not.toHaveBeenCalled()
+  })
