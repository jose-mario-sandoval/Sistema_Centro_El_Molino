+        ])
+        const { rows } = await c.query(
+          'select texto_eliminado from public.registro_moderacion where texto_eliminado like $1',
+          [`${PREFIJO}%`],
+        )
+        expect(rows).toEqual([{ texto_eliminado: `${PREFIJO}-reciente` }])
+      } finally {
+        await c.query('rollback')
+      }
+    })
