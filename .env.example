# Copiar a .env.local y completar. Nunca commitear valores reales.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Solo local, para npm run db:aplicar (nunca en Vercel)
SUPABASE_DB_PASSWORD=
SUPABASE_POOLER_HOST=aws-0-us-west-2.pooler.supabase.com

# Pista 06 (push). Generar con: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:contacto@example.com

# Pista 06 (cron). Generar con: openssl rand -hex 32
CRON_SECRET=
